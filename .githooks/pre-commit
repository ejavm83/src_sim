#!/bin/sh
# 커밋할 때마다 앱 버전(webapp.py의 APP_VERSION_INFO)을 올리고 시각을 지금으로 맞춘다.
#
# 설치(클론 후 한 번):  git config core.hooksPath .githooks
# 이번 커밋만 건너뛰기:  SKIP_VERSION_BUMP=1 git commit ...
#
# 버전 갱신이 실패해도 커밋 자체를 막지는 않는다 — 작업이 멈추는 편이 더 나쁘다.

[ -n "$SKIP_VERSION_BUMP" ] && exit 0

# 병합 커밋에서는 건너뛴다 (충돌 해결 중 파일을 건드리지 않도록)
[ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ] && exit 0

for PY in ".venv/Scripts/python.exe" ".venv/bin/python" "python3" "python" "py"; do
    if command -v "$PY" >/dev/null 2>&1 || [ -x "$PY" ]; then
        "$PY" scripts/bump_version.py --stage && exit 0
        break
    fi
done

echo "[pre-commit] 버전 갱신을 건너뛰었습니다 (python을 찾지 못했거나 실행 실패)." >&2
exit 0
